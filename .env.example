# Copy to .env (gitignored) and fill in real values there. No credentials here.
# APP_ENV must be demo, test, or production.
APP_ENV=development
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Backend only: never copy the following into a mobile/web bundle.
SUPABASE_SECRET_KEY=
# Optional: protected connection string used to apply schema/migrations and by
# scripts/check_supabase.py. Must include sslmode when remote.
SUPABASE_DB_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_INGEST_USERNAME=
MQTT_INGEST_PASSWORD=
MQTT_INGEST_CLIENT_ID=hostelxpress-backend-ingest
MQTT_CA_FILE=
# Public mobile app configuration only; naming chosen when app is scaffolded.
API_BASE_URL=http://localhost:8000
