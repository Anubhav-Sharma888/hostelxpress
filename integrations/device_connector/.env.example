# Export these values in the bot service environment. Keep actual values private.
HOSTELXPRESS_BOT_ID=00000000-0000-4000-8000-000000000001
HOSTELXPRESS_API_URL=https://backend.example.invalid
HOSTELXPRESS_DEVICE_SECRET=REPLACE_WITH_BACKEND_PROVISIONED_SECRET_AT_LEAST_32_CHARACTERS
HOSTELXPRESS_MQTT_HOST=broker.example.invalid
HOSTELXPRESS_MQTT_PORT=8883
HOSTELXPRESS_MQTT_USERNAME=REPLACE_WITH_THIS_BOTS_MQTT_IDENTITY
HOSTELXPRESS_MQTT_PASSWORD=REPLACE_WITH_THIS_BOTS_PRIVATE_MQTT_PASSWORD
# HOSTELXPRESS_MQTT_CA_FILE=/etc/hostelxpress/broker-ca.pem
# HOSTELXPRESS_LEDGER=/var/lib/hostelxpress/device-link.sqlite3
# Local HTTP testing only, paired with http://127.0.0.1:<port>; never enables nonlocal HTTP.
# HOSTELXPRESS_ALLOW_LOOPBACK_HTTP=1
